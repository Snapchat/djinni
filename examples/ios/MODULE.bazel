module(
    name = "djinni_ios_example",
    version = "0.1",
)

bazel_dep(name = "snap_djinni", version = "1.0.0", repo_name = "djinni_rules")
local_path_override(
    module_name = "snap_djinni",
    path = "../..",
)

bazel_dep(name = "rules_scala", version = "7.1.5")

scala_config = use_extension("@rules_scala//scala/extensions:config.bzl", "scala_config")
scala_config.settings(scala_version = "2.11.12")

bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "apple_support", version = "1.23.1", repo_name = "build_bazel_apple_support")
bazel_dep(name = "rules_swift", version = "2.4.0", repo_name = "build_bazel_rules_swift")
bazel_dep(name = "snap_djinni_apple", version = "1.0.0", repo_name = "djinni_apple")
local_path_override(
    module_name = "snap_djinni_apple",
    path = "../../support-lib/apple",
)

apple_cc = use_extension("@build_bazel_apple_support//crosstool:setup.bzl", "apple_cc_configure_extension")
use_repo(apple_cc, "local_config_apple_cc", "local_config_apple_cc_toolchains")

register_toolchains("@local_config_apple_cc_toolchains//:all")
