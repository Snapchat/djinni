###############################################################################
# Djinni Build Configuration
###############################################################################

# C Standard (required for protobuf utf8_range.c and other C code)
# Use 'common' to apply to all configurations (build, exec, host)
common --copt=-std=gnu99

# C++ Standard - overrides gnu99 for C++ files  
common --cxxopt=-std=c++17

# Android Configuration
build --incompatible_java_common_parameters=false
build --define=android_dexmerger_tool=d8_dexmerger
build --define=android_incremental_dexing_tool=d8_dexbuilder
# Note: --nouse_workers_with_dexbuilder removed in Bazel 7.x

# Bzlmod Configuration (Bazel 8.x)  
# Pure Bzlmod mode
common --enable_bzlmod=true

# Apple toolchain configuration for ObjC/Swift (Bazel 8.x + Bzlmod)
build --incompatible_enable_apple_toolchain_resolution

# Performance and caching
build --experimental_repository_cache_hardlinks
build --guard_against_concurrent_changes

# Enable build without the bytes (for faster remote builds)
build --remote_download_outputs=minimal
