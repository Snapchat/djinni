###############################################################################
# Djinni Build Configuration
###############################################################################

import %workspace%/.bazelrc.shared

# Root-workspace-only toolchain repositories. These repos are generated by
# dev-only module extensions and are not visible to downstream consumers.
build:macos --extra_toolchains=@local_config_apple_cc_toolchains//:all
build:apple --extra_toolchains=@local_config_apple_cc_toolchains//:all
build:wasm --extra_toolchains=@emsdk//emscripten_toolchain:all
