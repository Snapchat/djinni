"""Djinni compiler and reusable Bazel rules."""

module(
    name = "snap_djinni",
    version = "1.0.0",
    repo_name = "snap_djinni",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "rules_java", version = "8.14.0")
bazel_dep(name = "rules_scala", version = "7.1.5")
bazel_dep(name = "rules_jvm_external", version = "6.6")

scala_config = use_extension("@rules_scala//scala/extensions:config.bzl", "scala_config")
scala_config.settings(scala_version = "2.11.12")

scala_deps = use_extension("@rules_scala//scala/extensions:deps.bzl", "scala_deps")
scala_deps.scala()
use_repo(scala_deps, "io_bazel_rules_scala_scala_compiler", "io_bazel_rules_scala_scala_library", "io_bazel_rules_scala_scala_reflect")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven_djinni",
    artifacts = [
        "com.google.code.findbugs:jsr305:3.0.2",
        "com.github.scopt:scopt_2.11:3.7.1",
        "javax.inject:javax.inject:1",
        "org.scala-lang.modules:scala-parser-combinators_2.11:1.1.2",
        "org.yaml:snakeyaml:2.3",
    ],
    repositories = ["https://repo.maven.apache.org/maven2"],
)
use_repo(maven, "maven_djinni")

# These dependencies support this repository's tests, never downstream consumers.
bazel_dep(name = "rules_proto", version = "7.0.2", dev_dependency = True)
bazel_dep(name = "protobuf", version = "29.0", dev_dependency = True, repo_name = "com_google_protobuf")
bazel_dep(name = "googletest", version = "1.14.0.bcr.1", dev_dependency = True, repo_name = "gtest")
bazel_dep(name = "apple_support", version = "1.23.1", dev_dependency = True, repo_name = "build_bazel_apple_support")
bazel_dep(name = "rules_apple", version = "4.0.0", dev_dependency = True, repo_name = "build_bazel_rules_apple")
bazel_dep(name = "rules_swift", version = "2.4.0", dev_dependency = True, repo_name = "build_bazel_rules_swift")
bazel_dep(name = "emsdk", version = "4.0.17", dev_dependency = True)
bazel_dep(name = "snap_djinni_apple", version = "1.0.0", dev_dependency = True, repo_name = "djinni_apple")

apple_cc = use_extension("@build_bazel_apple_support//crosstool:setup.bzl", "apple_cc_configure_extension", dev_dependency = True)
use_repo(apple_cc, "local_config_apple_cc", "local_config_apple_cc_toolchains")

local_path_override(
    module_name = "snap_djinni_apple",
    path = "support-lib/apple",
)

single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = ["//bzl:protobuf_c99.patch"],
)

test_maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven", dev_dependency = True)
test_maven.install(
    name = "maven_djinni_tests",
    artifacts = [
        "com.google.code.findbugs:jsr305:3.0.2",
        "io.reactivex.rxjava2:rxjava:2.2.21",
        "junit:junit:4.13.2",
    ],
    repositories = ["https://repo.maven.apache.org/maven2"],
)
use_repo(test_maven, "maven_djinni_tests")

non_module_deps = use_extension("//bzl:extensions.bzl", "non_module_deps", dev_dependency = True)
use_repo(non_module_deps, "apple_swift_protobuf")
