@extern "../../../../support-lib/supplier.yaml"

# Simple object interface for supplier testing
simple_object = interface +c {
    get_value(): i32;
    get_name(): string;
}

nested_supplier = record {
  s: supplier<i32>;
}

nested_supplier_interface = record {
  obj: supplier<simple_object>;
}

test_supplier = interface +c {
	# Simple type supplier tests
	static getSupplierString(): supplier<string>;
	static getSupplierInt(): supplier<i32>;

    static callSupplierString(x: supplier<string>): string;
	static callSupplierInt(x: supplier<i32>): i32;

	static getNestedSupplier(): nested_supplier;
    static callNestedSupplier(x: nested_supplier): i32;

	# Interface supplier tests - main use case for deferred expensive object creation
	static getSupplierObject(): supplier<simple_object>;
	static callSupplierObject(x: supplier<simple_object>): i32;
	static callSupplierObjectGetName(x: supplier<simple_object>): string;

	static getNestedSupplierInterface(): nested_supplier_interface;
	static callNestedSupplierInterface(x: nested_supplier_interface): i32;

	# Helper to create simple_object for testing
	static createSimpleObject(value: i32, name: string): simple_object;
}
