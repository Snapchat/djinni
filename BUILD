# Android platform definitions for rules_android_ndk
# See https://github.com/bazelbuild/rules_android_ndk

platform(
    name = "arm64-v8a",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:android",
    ],
)

