"""Optional Swift runtime; importing core Djinni does not import this module."""

module(
    name = "snap_djinni_apple",
    version = "1.0.0",
)

bazel_dep(name = "snap_djinni", version = "1.0.0", repo_name = "djinni_rules")
bazel_dep(name = "rules_cc", version = "0.1.1")
